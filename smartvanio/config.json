  "hassio_api": true,
  "host_network": true,
  "options": {
    "dev_mode": false,
    "ha_host": "homeassistant",
    "ha_port": 8123
  },
  "schema": {
    "dev_mode": "bool",
    "ha_host": "str",
    "ha_port": "int"
  },
  "ports": {
    "3000/tcp": 3000
