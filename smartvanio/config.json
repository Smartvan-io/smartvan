{
  "name": "Smartvan.io",
  "version": "1.0.9-beta",
  "slug": "smartvanio",
  "description": "Smartvan.io Add-on - Manage all your SmartVan devices in one place!",
  "arch": ["amd64", "armv7", "aarch64", "armhf", "i386"],
  "startup": "application",
  "boot": "auto",
  "init": false,
  "hassio_role": "admin",
  "ingress": true,
  "ingress_port": 3000,
  "panel_icon": "mdi:earth",
